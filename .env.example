# Postgres with pgvector. Local dev: provide your own connection string.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# better-auth — generate a 32+ byte random secret for production.
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:5173"

# OpenAI — used for both chat (gpt-4o) and embeddings (text-embedding-3-small).
OPENAI_API_KEY=""

# Resend transactional email. Optional in dev — when blank, OTP codes are
# logged to the server console instead of emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Daniel's AI <noreply@danielovieda.com>"

# Public site URL used by emails and absolute redirects.
PUBLIC_SITE_URL="http://localhost:5173"

# Admin email allowlist — the only address that can sign in to /admin.
ADMIN_EMAIL="ovieda@gmail.com"

# Chat limits. Server-enforced; bad/missing values fall back to defaults.
#   - Max characters per single user message (default 2000, range 100–50000).
#   - Max total user messages per verified visitor over their lifetime
#     (default 30, range 1–10000). Dev bypass visitor is exempt.
CHAT_MAX_MESSAGE_CHARS="2000"
CHAT_MAX_MESSAGES_PER_VISITOR="30"

# Dev-only: when set to the literal string "true", skip visitor OTP verification
# and unlock chat immediately. The chat persists as a placeholder "Dev Bypass"
# visitor row so transcripts remain inspectable in /admin/visitors. NEVER set
# this in production.
DEV_CHAT_BYPASS="false"

# Shared secret for the Japanese daily-study endpoints (/api/jp/*), called by
# the house machine — not by a browser. Generate with:
#   openssl rand -hex 32
# Unset means those endpoints reject every request; they never fall open.
JP_API_TOKEN=""

# HMAC key for the signed /jp/<token> survey links. Separate from
# BETTER_AUTH_SECRET on purpose: rotating your auth secret should log you out,
# not silently 404 every survey link in every email already sent. Generate with:
#   openssl rand -hex 32
# Unset means links cannot be signed OR verified — it fails closed, never open.
# This key stays on Vercel; the house machine never needs it, because
# POST /api/jp/day returns the finished survey URL.
JP_LINK_SECRET=""

# HMAC key for /work/<token> links. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Deliberately NOT shared with JP_LINK_SECRET or BETTER_AUTH_SECRET.
WORK_LINK_SECRET=""
# Bump to revoke every work link already sent in an email. Defaults to 1.
WORK_LINK_ROTATION="1"

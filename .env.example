# Postgres with pgvector. Local dev: provide your own connection string.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# better-auth — generate a 32+ byte random secret for production.
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:5173"

# OpenAI — used for both chat (gpt-4o) and embeddings (text-embedding-3-small).
OPENAI_API_KEY=""

# Resend transactional email. Optional in dev — when blank, OTP codes are
# logged to the server console instead of emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Daniel's AI <noreply@danielovieda.com>"

# Public site URL used by emails and absolute redirects.
PUBLIC_SITE_URL="http://localhost:5173"

# Admin email allowlist — the only address that can sign in to /admin.
ADMIN_EMAIL="ovieda@gmail.com"
